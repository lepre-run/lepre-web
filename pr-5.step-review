diff --git a/src/components/ui/CountUp/CountUp.test.tsx b/src/components/ui/CountUp/CountUp.test.tsx
new file mode 100644
index 0000000..bca779d
--- /dev/null
+++ b/src/components/ui/CountUp/CountUp.test.tsx
@@ -0,0 +1,62 @@
+import { act, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { preferReducedMotion, stubAnimationFrames } from "../../../test/motion";
+import { CountUp } from "./CountUp";
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+const runs = (value: number): string => `${Math.round(value)} runs`;
+
+function renderCount(value: number) {
+  const view = render(
+    <p>
+      <CountUp value={value} format={runs} />
+    </p>,
+  );
+  return (next: number) =>
+    view.rerender(
+      <p>
+        <CountUp value={next} format={runs} />
+      </p>,
+    );
+}
+
+describe("CountUp", () => {
+  it("renders the formatted value as plain text when nothing is counting", () => {
+    stubAnimationFrames();
+    renderCount(3);
+    expect(screen.getByText("3 runs")).not.toHaveAttribute("aria-hidden");
+  });
+
+  it("hides intermediate frames from assistive technology and exposes only the final value", () => {
+    const frames = stubAnimationFrames();
+    const update = renderCount(3);
+
+    update(30);
+    act(() => frames.runFrame(0));
+    act(() => frames.runFrame(100));
+
+    const animated = document.querySelector(".count-up");
+    expect(animated).toHaveAttribute("aria-hidden", "true");
+    expect(animated?.textContent).not.toBe("30 runs");
+    expect(screen.getByText("30 runs")).toHaveClass("visually-hidden");
+
+    act(() => frames.runFrame(400));
+    expect(document.querySelector(".count-up")).toBeNull();
+    expect(screen.getByText("30 runs")).not.toHaveClass("visually-hidden");
+  });
+
+  it("shows the final value at once when reduced motion is preferred", () => {
+    preferReducedMotion();
+    stubAnimationFrames();
+    const update = renderCount(3);
+
+    update(30);
+
+    expect(document.querySelector(".count-up")).toBeNull();
+    expect(screen.getByText("30 runs")).toBeInTheDocument();
+  });
+});
diff --git a/src/components/ui/CountUp/CountUp.tsx b/src/components/ui/CountUp/CountUp.tsx
new file mode 100644
index 0000000..8eab399
--- /dev/null
+++ b/src/components/ui/CountUp/CountUp.tsx
@@ -0,0 +1,19 @@
+import type { ReactNode } from "react";
+import { useCountUp } from "../../../hooks/useCountUp";
+
+export function CountUp({
+  value,
+  format,
+}: Readonly<{ value: number; format: (value: number) => string }>): ReactNode {
+  const finalText = format(value);
+  const text = format(useCountUp(value));
+  if (text === finalText) return finalText;
+  return (
+    <>
+      <span className="count-up" aria-hidden="true">
+        {text}
+      </span>
+      <span className="visually-hidden">{finalText}</span>
+    </>
+  );
+}
diff --git a/src/components/ui/HareLoader/HareLoader.test.tsx b/src/components/ui/HareLoader/HareLoader.test.tsx
new file mode 100644
index 0000000..a933655
--- /dev/null
+++ b/src/components/ui/HareLoader/HareLoader.test.tsx
@@ -0,0 +1,44 @@
+import { act, render } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { preferReducedMotion, stubMediaQuery } from "../../../test/motion";
+import { HareLoader } from "./HareLoader";
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+function renderHare() {
+  const { container } = render(<HareLoader className="sync-status__hare" />);
+  return container.querySelector("svg");
+}
+
+describe("HareLoader", () => {
+  it("draws a decorative hare that stays out of the accessibility tree", () => {
+    const hare = renderHare();
+    expect(hare).toHaveClass("hare-loader", "sync-status__hare");
+    expect(hare).toHaveAttribute("aria-hidden", "true");
+    expect(hare).toHaveAttribute("focusable", "false");
+  });
+
+  it("hops when the runner allows motion", () => {
+    stubMediaQuery(false);
+    expect(renderHare()).toHaveAttribute("data-motion", "full");
+  });
+
+  it("stands still when reduced motion is preferred, including after a live change", () => {
+    const query = stubMediaQuery(false);
+    const hare = renderHare();
+
+    act(() => {
+      Object.assign(query, { matches: true });
+      query.dispatchEvent(new Event("change"));
+    });
+
+    expect(hare).toHaveAttribute("data-motion", "reduced");
+  });
+
+  it("stands still from the first frame under reduced motion", () => {
+    preferReducedMotion();
+    expect(renderHare()).toHaveAttribute("data-motion", "reduced");
+  });
+});
diff --git a/src/components/ui/HareLoader/HareLoader.tsx b/src/components/ui/HareLoader/HareLoader.tsx
new file mode 100644
index 0000000..eac5f9b
--- /dev/null
+++ b/src/components/ui/HareLoader/HareLoader.tsx
@@ -0,0 +1,26 @@
+import type { JSX } from "react";
+import { usePrefersReducedMotion } from "../../../hooks/usePrefersReducedMotion";
+
+export function HareLoader({ className }: Readonly<{ className?: string }>): JSX.Element {
+  const reducedMotion = usePrefersReducedMotion();
+  return (
+    <svg
+      className={["hare-loader", className].filter(Boolean).join(" ")}
+      data-motion={reducedMotion ? "reduced" : "full"}
+      viewBox="0 0 48 32"
+      aria-hidden="true"
+      focusable="false"
+    >
+      <ellipse className="hare-loader__ground" cx="24" cy="30" rx="13" ry="1.4" />
+      <g className="hare-loader__hare">
+        <path d="M33 11C30 4 31 1 33 2s3 5 3 9" />
+        <path d="M36 10c0-7 2-9 3.5-7.5S40 8 38.5 11" />
+        <ellipse cx="25" cy="19" rx="11" ry="7" />
+        <circle cx="38" cy="14.5" r="5" />
+        <circle className="hare-loader__tail" cx="13.5" cy="15.5" r="2.5" />
+        <path className="hare-loader__leg" d="M32 24l6 2.5M18 24c-4 1-6 2-9 2" />
+        <circle className="hare-loader__eye" cx="39.6" cy="13.4" r="0.9" />
+      </g>
+    </svg>
+  );
+}
diff --git a/src/components/ui/HareLoader/hare-loader.css b/src/components/ui/HareLoader/hare-loader.css
new file mode 100644
index 0000000..3bf1178
--- /dev/null
+++ b/src/components/ui/HareLoader/hare-loader.css
@@ -0,0 +1,58 @@
+.hare-loader {
+  display: inline-block;
+  flex: none;
+  width: 3rem;
+  height: auto;
+  overflow: visible;
+}
+
+.hare-loader__hare {
+  fill: var(--color-kinetic);
+  stroke: var(--color-carbon);
+  stroke-width: 2;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  transform-box: fill-box;
+  transform-origin: 50% 100%;
+  animation: hare-hop var(--motion-duration-loop) var(--motion-ease-in-out)
+    var(--motion-loop-iterations);
+}
+
+.hare-loader__tail {
+  fill: var(--color-lab-paper);
+}
+
+.hare-loader__leg {
+  fill: none;
+}
+
+.hare-loader__eye {
+  fill: var(--color-carbon);
+  stroke: none;
+}
+
+.hare-loader__ground {
+  fill: var(--color-carbon);
+  opacity: 0.18;
+  transform-box: fill-box;
+  transform-origin: center;
+  animation: hare-ground var(--motion-duration-loop) var(--motion-ease-in-out)
+    var(--motion-loop-iterations);
+}
+
+.hare-loader[data-motion="reduced"] :is(.hare-loader__hare, .hare-loader__ground) {
+  animation: none;
+}
+
+@keyframes hare-hop {
+  50% {
+    transform: translateY(-22%) rotate(-8deg);
+  }
+}
+
+@keyframes hare-ground {
+  50% {
+    opacity: 0.08;
+    transform: scaleX(0.7);
+  }
+}
