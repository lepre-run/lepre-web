 import { localeFor } from "../../../i18n/i18n";
 import { workoutDetail, workoutKind, workoutType } from "../weeklyFormatters";
 
 export function WorkoutButton({
   workout,
   selected,
   language,
   onSelect,
+  arrivalOrder,
 }: Readonly<{
   workout: Workout;
   selected: boolean;
   language: string;
   onSelect: () => void;
+  arrivalOrder?: number;
 }>): JSX.Element {
