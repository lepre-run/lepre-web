diff --git a/src/components/weekly-overview/WeekRow/WeekRow.tsx b/src/components/weekly-overview/WeekRow/WeekRow.tsx
index 6ddbf35..9d45c65 100644
--- a/src/components/weekly-overview/WeekRow/WeekRow.tsx
