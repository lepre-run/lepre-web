#step-review:round
{
  "$schema": "https://step-review.dev/schema/v1.json",
  "version": 1,
  "createdAt": "2026-10-22T08:30:00Z",
  "target": {
    "title": "Joyful micro-animations: motion tokens, run arrival, count-up totals, hare loader, empty state",
    "url": "https://github.com/lepre-run/lepre-web/pull/5",
    "baseRef": "main",
    "headRef": "feat/4-micro-animations",
    "baseCommit": "ed47c6fdd7f52cb0b6a52e62d858615b2fc690b7",
    "headCommit": "b89bf6acadabd7e39313208f88a3073bd213a956"
  },
  "overview": {
    "summary": "Implements issue #4. It adds motion tokens with a global reduced-motion rule, count-up totals with accessible final values, newest-first arrival animations for runs added by sync (capped at 6 with a 30 ms stagger, marks clearing after 400 ms), a hopping SVG hare for loading and sync, and a friendlier English/Italian empty state. It adds no dependencies (+1.3 kB gz JS / +0.6 kB gz CSS against main) and doesn't touch the domain, application, infrastructure or composition layers. At this head, all 9 findings from the first review are addressed. The remaining issues are small: the width of the fixed sync slot on narrow phones, the expiry timer having no margin, and two missing timer tests.",
    "areas": [
      {
        "title": "Foundation",
        "points": [
          "Tokens in `src/styles/foundation.css`, plus a two-layer reduced-motion rule ([explainer](note:n1)).",
          "`usePrefersReducedMotion` follows live media-query changes."
        ]
      },
      {
        "title": "Arrivals",
        "points": [
          "The baseline is the first `ready` render; the race is accepted and documented ([explainer](note:n11)).",
          "Expiry timer and identity check ([explainer](note:n8)); no-margin timing ([issue](note:n9)); missing tests ([issue](note:n10))."
        ]
      },
      {
        "title": "Hare and sync status",
        "points": [
          "The fixed 1.5rem slot removes the width jump but may crowd narrow phones ([issue](note:n16))."
        ]
      }
    ],
    "readingPlan": "Read the foundation first: every later step relies on its tokens and reduced-motion rule. Then the two logic steps, count-up and arrivals, which deserve the most attention. The hare loader is mostly CSS and accessibility wiring; the empty state and copy are skimmable."
  },
  "steps": [
    {
      "id": "motion-foundation",
      "title": "Motion tokens and reduced-motion foundation",
      "attention": "high",
      "intro": "Adds duration, easing, stagger and loop tokens. Moves existing transitions onto them, and adds a two-layer reduced-motion rule: token overrides plus an `!important` catch-all. Also adds `usePrefersReducedMotion` and the `matchMedia` test stub. What to check: the scope of the catch-all and that the old local reduced-motion blocks are gone.",
      "files": [
        {
          "path": "src/styles/foundation.css",
          "notes": [
            {
              "id": "n1",
              "kind": "explainer",
              "body": "Two layers. The `:root` overrides collapse every token-driven duration, stagger and loop count. The catch-all on `*, ::before, ::after` handles any hard-coded duration. It changes only duration, delay and iteration count, never `animation-name`, so `animation: none` rules such as the hare's reduced-motion pose still apply. Nothing in `src` listens for `animationend` or `transitionend`, and 1 ms durations still fire those events anyway.",
              "anchor": {
                "side": "new",
                "line": 163,
                "text": "@media (prefers-reduced-motion: reduce) {",
                "endLine": 187
              }
            },
            {
              "id": "n2",
              "kind": "explainer",
              "body": "Biome 2.x range suppression. It covers only the five `!important` declarations, and `npm run check` passes at this head.",
              "anchor": {
                "side": "new",
                "line": 180,
                "text": "    /* biome-ignore-start lint/complexity/noImportantStyles: reduced motion must beat component animations that hard-code durations. */",
                "endLine": 186
              }
            }
          ]
        },
        {
          "path": "src/styles/neo-brutalist-foundation.css"
        },
        {
          "path": "src/styles.css"
        },
        {
          "path": "src/components/workouts/SourceLapEvidence/source-lap-evidence.css"
        },
        {
          "path": "src/hooks/motionDurations.ts"
        },
        {
          "path": "src/hooks/usePrefersReducedMotion.ts",
          "notes": [
            {
              "id": "n3",
              "kind": "explainer",
              "body": "`useSyncExternalStore` makes the hook follow live media-query changes. It falls back to `false` when `matchMedia` is missing (SSR or tests).",
              "anchor": {
                "side": "new",
                "line": 19,
                "text": "export function usePrefersReducedMotion(): boolean {",
                "endLine": 21
              }
            }
          ]
        },
        {
          "path": "src/hooks/usePrefersReducedMotion.test.ts"
        },
        {
          "path": "src/test-setup.ts"
        },
        {
          "path": "src/test/motion.ts"
        }
      ]
    },
    {
      "id": "count-up",
      "title": "Count-up totals",
      "attention": "high",
      "intro": "Adds a pure easing helper (`countUpValue`), a `useCountUp` hook built on `requestAnimationFrame`, and an accessible `CountUp` component. These are wired into the volume, training-mix, dashboard-summary and feed counts. Pace is deliberately not counted.",
      "files": [
        {
          "path": "src/hooks/countUp.ts"
        },
        {
          "path": "src/hooks/countUp.test.ts"
        },
        {
          "path": "src/hooks/useCountUp.ts",
          "notes": [
            {
              "id": "n4",
              "kind": "explainer",
              "body": "No animation on the first render (`displayedRef` starts at `value`). Under reduced motion the hook jumps straight to the value. An interrupted animation restarts from the last displayed frame, because `displayedRef` is updated on every frame. The effect cleanup cancels the pending frame.",
              "anchor": {
                "side": "new",
                "line": 38,
                "text": "    if (reducedMotion || displayedRef.current === value) {",
                "endLine": 45
              }
            }
          ]
        },
        {
          "path": "src/hooks/useCountUp.test.ts"
        },
        {
          "path": "src/components/ui/CountUp/CountUp.tsx",
          "notes": [
            {
              "id": "n5",
              "kind": "explainer",
              "body": "Screen readers only get the final value: the animated text is `aria-hidden`, and a visually hidden span holds the final text. Once the count settles, it collapses back to plain text.",
              "anchor": {
                "side": "new",
                "line": 10,
                "text": "  if (text === finalText) return finalText;",
                "endLine": 18
              }
            }
          ]
        },
        {
          "path": "src/components/ui/CountUp/CountUp.test.tsx"
        },
        {
          "path": "src/components/ui/index.ts"
        },
        {
          "path": "src/components/dashboard/VolumeCard/VolumeCard.tsx"
        },
        {
          "path": "src/components/dashboard/TrainingMixCard/TrainingMixCard.tsx"
        },
        {
          "path": "src/components/dashboard/ConditionDashboard/ConditionDashboard.tsx"
        },
        {
          "path": "src/components/home/FeedHeader/FeedHeader.tsx"
        },
        {
          "path": "src/components/home/FeedHeader/FeedHeader.test.tsx"
        }
      ]
    },
    {
      "id": "arrivals",
      "title": "New-run arrival detection and animation",
      "attention": "high",
      "intro": "Pure helpers find the ids that are new since the last known set and order them newest first, capped at 6. `useWorkoutArrivals` sets its baseline on the first `ready` render and clears marks 400 ms after each batch. `WorkoutButton` gets `data-new` and an `--arrival-order` stagger. What to check: the baseline, the expiry timer, and the replay test.",
      "files": [
        {
          "path": "src/components/weekly-overview/workoutArrivals.ts",
          "notes": [
            {
              "id": "n6",
              "kind": "explainer",
              "body": "Arrivals are sorted newest first and capped at `STAGGERED_ARRIVAL_LIMIT` (6). With the 30 ms stagger and the 250 ms base duration, the last item ends at 5×30+250 = 400 ms. Arrivals past the cap appear without animation.",
              "anchor": {
                "side": "new",
                "line": 21,
                "text": "  const newest = workouts",
                "endLine": 25
              }
            }
          ]
        },
        {
          "path": "src/components/weekly-overview/workoutArrivals.test.ts"
        },
        {
          "path": "src/hooks/useWorkoutArrivals.ts",
          "notes": [
            {
              "id": "n7",
              "kind": "explainer",
              "body": "The tracking state is derived during render (React's \"adjust state while rendering\" pattern), so arrivals are visible in the same commit as the new workouts. A no-new-ids refresh keeps the same `arrivals` map identity, so settled items don't restart.",
              "anchor": {
                "side": "new",
                "line": 46,
                "text": "  const [tracking, setTracking] = useState(() => trackArrivals(UNTRACKED, workouts, hydrated));",
                "endLine": 49
              }
            },
            {
              "id": "n8",
              "kind": "explainer",
              "body": "Expiry timer. The cleanup runs on unmount and whenever `current.arrivals` changes. `settleArrivals` only clears the marks if they are still the same map, so an older batch's timeout can't wipe a newer batch's marks.",
              "anchor": {
                "side": "new",
                "line": 50,
                "text": "  useEffect(() => {",
                "endLine": 63
              }
            },
            {
              "id": "n9",
              "kind": "issue",
              "severity": "nit",
              "body": "The timer fires at exactly the longest arrival animation (5×30 ms stagger + 250 ms base = 400 ms), with no margin. If the effect runs before paint, the 6th item can lose its last few ms. The match with `--motion-duration-slow` is also coincidental: changing the stagger or base token would silently desynchronise it. Suggestion: add a small buffer, or derive the constant from the arrival budget (limit, stagger, base) instead of the \"slow\" token.",
              "anchor": {
                "side": "new",
                "line": 55,
                "text": "      MOTION_DURATION_SLOW_MS,"
              }
            }
          ]
        },
        {
          "path": "src/hooks/useWorkoutArrivals.test.ts",
          "notes": [
            {
              "id": "n10",
              "kind": "issue",
              "severity": "nit",
              "body": "The fake-timer test only covers expiry. Two cases are missing: unmounting before 400 ms (no pending timer, no state update after unmount), and a second batch arriving at about 200 ms (its marks must survive the first batch's deadline and clear 400 ms after their own start). The code handles both already; add the tests so it stays that way.",
              "anchor": {
                "side": "new",
                "line": 72,
                "text": "  it(\"clears arrival marks once the entrance animation has finished\", () => {",
                "endLine": 82
              }
            }
          ]
        },
        {
          "path": "src/pages/Home.tsx",
          "notes": [
            {
              "id": "n11",
              "kind": "explainer",
              "body": "The baseline is the first render with `screen.kind === \"ready\"`. The known race (the first sync batch committing in the same render as `ready`) is accepted and documented in the PR body. Its worst case is a missed animation, never a wrong one. A guaranteed fix would need a `hydrated` signal from `useHomeController`.",
              "anchor": {
                "side": "new",
                "line": 17,
                "text": "  const arrivals = useWorkoutArrivals(controller.workouts, controller.screen.kind === \"ready\");"
              }
            }
          ]
        },
        {
          "path": "src/pages/Home.test.tsx"
        },
        {
          "path": "src/components/weekly-overview/WeeklyOverview/WeeklyOverview.tsx"
        },
        {
          "path": "src/components/weekly-overview/WeekRow/WeekRow.tsx"
        },
        {
          "path": "src/components/weekly-overview/WeeklyDay/WeeklyDay.tsx"
        },
        {
          "path": "src/components/weekly-overview/WorkoutButton/WorkoutButton.tsx"
        },
        {
          "path": "src/components/weekly-overview/WorkoutButton/WorkoutButton.test.tsx"
        },
        {
          "path": "src/components/weekly-overview/WeeklyOverview/weekly-overview.css",
          "notes": [
            {
              "id": "n12",
              "kind": "explainer",
              "body": "Transform and opacity only, through the shared `motion-settle-in` keyframe. With `backwards` fill, a staggered item stays hidden during its delay instead of flashing in place.",
              "anchor": {
                "side": "new",
                "line": 171,
                "text": ".weekly-workout[data-new=\"true\"] {",
                "endLine": 174
              }
            }
          ]
        },
        {
          "path": "src/components/weekly-overview/WeeklyOverview/weekly-overview-theme.css"
        },
        {
          "path": "src/components/weekly-overview/WeeklyOverview/WeeklyOverviewArrivals.test.tsx",
          "notes": [
            {
              "id": "n13",
              "kind": "explainer",
              "body": "A regression test for the first review's replay finding: after expiry, paging to older weeks and back must not bring `data-new` back.",
              "anchor": {
                "side": "new",
                "line": 31,
                "text": "  it(\"does not replay the arrival animation after paging away and back\", () => {",
                "endLine": 46
              }
            }
          ]
        }
      ]
    },
    {
      "id": "hare-loader",
      "title": "Hare loader in loading and sync states",
      "attention": "normal",
      "intro": "Adds an inline SVG `HareLoader`, which is `aria-hidden` and exposes `data-motion` for its reduced-motion pose. It is used in `LoadingHome` and in the sync status while checking or syncing, sharing one fixed slot with the status dot.",
      "files": [
        {
          "path": "src/components/ui/HareLoader/HareLoader.tsx"
        },
        {
          "path": "src/components/ui/HareLoader/hare-loader.css",
          "notes": [
            {
              "id": "n14",
              "kind": "explainer",
              "body": "The reduced-motion pose. `animation: none` resets the animation name, which the global catch-all leaves alone, so the hare stands still instead of playing a single 1 ms hop.",
              "anchor": {
                "side": "new",
                "line": 43,
                "text": ".hare-loader[data-motion=\"reduced\"] :is(.hare-loader__hare, .hare-loader__ground) {",
                "endLine": 45
              }
            }
          ]
        },
        {
          "path": "src/components/ui/HareLoader/HareLoader.test.tsx"
        },
        {
          "path": "src/components/home/AppHeader/AppHeader.tsx",
          "notes": [
            {
              "id": "n15",
              "kind": "explainer",
              "body": "The slot is `aria-hidden` inside the unchanged `role=status` / `aria-live` region, so screen readers still only announce the text label.",
              "anchor": {
                "side": "new",
                "line": 45,
                "text": "          <span className=\"sync-status__slot\" aria-hidden=\"true\">",
                "endLine": 51
              }
            }
          ]
        },
        {
          "path": "src/components/home/AppHeader/app-header.css",
          "notes": [
            {
              "id": "n16",
              "kind": "issue",
              "severity": "concern",
              "body": "The slot is now always 1.5rem wide, including in the settled states that used to have a 0.48rem dot. At ≤420px, `.sync-status` is capped at `max-width: 5.5rem` (`condition-dashboard.css:386-388`), so the label loses about 1rem there and may wrap onto an extra line. On wider screens the gap between the dot and the text roughly doubles. Check it at 360–420px; if it's cramped, left-align the dot (`justify-content: flex-start`) or narrow the slot and the mini hare to about 1.1rem.",
              "anchor": {
                "side": "new",
                "line": 52,
                "text": "  inline-size: 1.5rem;"
              }
            }
          ]
        },
        {
          "path": "src/components/home/AppHeader/AppHeader.test.tsx"
        },
        {
          "path": "src/components/home/PublicHome/PublicHome.tsx"
        },
        {
          "path": "src/components/home/PublicHome/public-home.css"
        },
        {
          "path": "src/components/home/PublicHome/LoadingHome.test.tsx"
        }
      ]
    },
    {
      "id": "empty-state",
      "title": "Friendlier empty state and copy",
      "attention": "low",
      "intro": "Extracts `EmptyWorkoutFeed` from `Home.tsx`, shows the hare while importing, and hides the description during import. Adds a settle-in entrance and updates the English and Italian copy.",
      "files": [
        {
          "path": "src/components/home/EmptyWorkoutFeed/EmptyWorkoutFeed.tsx",
          "notes": [
            {
              "id": "n17",
              "kind": "explainer",
              "body": "The description now renders only when not syncing, so \"Head out for a run\" no longer sits under \"The hare is fetching…\". The empty state was never a live region; sync status is announced by the `AppHeader` region.",
              "anchor": {
                "side": "new",
                "line": 11,
                "text": "      {!syncing && <p>{t(\"feed.emptyDescription\")}</p>}"
              }
            }
          ]
        },
        {
          "path": "src/components/home/EmptyWorkoutFeed/EmptyWorkoutFeed.test.tsx"
        },
        {
          "path": "src/components/home/home-theme.css"
        },
        {
          "path": "src/i18n/locales/en.ts"
        },
        {
          "path": "src/i18n/locales/it.ts"
        }
      ]
    }
  ]
