diff --git a/src/components/dashboard/ConditionDashboard/ConditionDashboard.tsx b/src/components/dashboard/ConditionDashboard/ConditionDashboard.tsx
index 76a7b44..b4807b0 100644
--- a/src/components/dashboard/ConditionDashboard/ConditionDashboard.tsx
+++ b/src/components/dashboard/ConditionDashboard/ConditionDashboard.tsx
@@ -1,51 +1,55 @@
 import type { JSX } from "react";
 import { useTranslation } from "react-i18next";
 import { createTrainingDashboard } from "../../../domain/training-dashboard";
 import type { Workout } from "../../../domain/workout";
 import { localeFor } from "../../../i18n/i18n";
+import { CountUp } from "../../ui";
 import { EasyPaceCard } from "../EasyPaceCard/EasyPaceCard";
 import { IntervalsCard } from "../IntervalsCard/IntervalsCard";
 import { TrainingMixCard } from "../TrainingMixCard/TrainingMixCard";
 import { VolumeCard } from "../VolumeCard/VolumeCard";
 
 export function ConditionDashboard({
   workouts,
 }: Readonly<{ workouts: ReadonlyArray<Workout> }>): JSX.Element | null {
   const { t, i18n } = useTranslation();
   const language = i18n.resolvedLanguage ?? i18n.language;
   const dashboard = createTrainingDashboard(workouts);
   if (dashboard === null) return null;
   const through = new Intl.DateTimeFormat(localeFor(language), {
     day: "numeric",
     month: "short",
     year: "numeric",
   }).format(new Date(dashboard.through));
 
   return (
     <section className="condition-dashboard" aria-labelledby="condition-dashboard-title">
       <header className="condition-dashboard__header">
         <div>
           <p className="eyebrow">{t("dashboard.eyebrow")}</p>
           <h1 id="condition-dashboard-title">{t("dashboard.title")}</h1>
           <p className="condition-dashboard__summary">
-            {t("dashboard.summary", { count: dashboard.workoutCount })}
+            <CountUp
+              value={dashboard.workoutCount}
+              format={(count) => t("dashboard.summary", { count: Math.round(count) })}
+            />
           </p>
         </div>
         <div className="condition-dashboard__window">
           <strong>{t("dashboard.window")}</strong>
           <span>{t("dashboard.through", { date: through })}</span>
         </div>
       </header>
       <div className="condition-dashboard__grid">
         <EasyPaceCard insight={dashboard.easyPace} language={language} />
         <IntervalsCard insight={dashboard.referenceIntervals} language={language} />
         <VolumeCard
           insight={dashboard.weeklyVolume}
           language={language}
           windowDays={dashboard.windowDays}
         />
         <TrainingMixCard mix={dashboard.trainingMix} />
       </div>
       <p className="condition-dashboard__method">{t("dashboard.method")}</p>
     </section>
   );
diff --git a/src/components/dashboard/TrainingMixCard/TrainingMixCard.tsx b/src/components/dashboard/TrainingMixCard/TrainingMixCard.tsx
index 758c24c..5adb9d8 100644
--- a/src/components/dashboard/TrainingMixCard/TrainingMixCard.tsx
+++ b/src/components/dashboard/TrainingMixCard/TrainingMixCard.tsx
@@ -1,47 +1,55 @@
 import type { JSX } from "react";
 import { useTranslation } from "react-i18next";
 import type { TrainingMixInsight } from "../../../domain/training-dashboard";
+import { CountUp } from "../../ui";
 import { DashboardCard } from "../DashboardCard/DashboardCard";
 
 export function TrainingMixCard({ mix }: Readonly<{ mix: TrainingMixInsight }>): JSX.Element {
   const { t } = useTranslation();
   const classified = mix.low + mix.moderate + mix.high;
   const width = (value: number): string => `${classified === 0 ? 0 : (value / classified) * 100}%`;
   return (
     <DashboardCard
       kind="mix"
       title={t("dashboard.mix.title")}
       badge={<span className="condition-card__period">{t("dashboard.mix.sessionPurpose")}</span>}
     >
       <p className="condition-card__metric">
-        {mix.lowSharePercent === null ? "—" : Math.round(mix.lowSharePercent)}
+        {mix.lowSharePercent === null ? (
+          "—"
+        ) : (
+          <CountUp value={mix.lowSharePercent} format={(percent) => `${Math.round(percent)}`} />
+        )}
         <small>% {t("dashboard.mix.low")}</small>
       </p>
       <div
         className="training-mix"
         role="img"
         aria-label={t("dashboard.mix.ariaLabel", {
           low: mix.low,
           moderate: mix.moderate,
           high: mix.high,
         })}
       >
         <span className="training-mix__low" style={{ width: width(mix.low) }} />
         <span className="training-mix__moderate" style={{ width: width(mix.moderate) }} />
         <span className="training-mix__high" style={{ width: width(mix.high) }} />
         <i aria-hidden="true" title={t("dashboard.mix.reference")} />
       </div>
       <p className="condition-card__context condition-card__context--legend">
         <span>{t("dashboard.mix.lowCount", { count: mix.low })}</span>
         <span>{t("dashboard.mix.moderateCount", { count: mix.moderate })}</span>
         <span>{t("dashboard.mix.highCount", { count: mix.high })}</span>
       </p>
       <footer>
         <span>
-          {t("dashboard.mix.coverage", { value: Math.round(mix.classifiedSharePercent) })}
+          <CountUp
+            value={mix.classifiedSharePercent}
+            format={(percent) => t("dashboard.mix.coverage", { value: Math.round(percent) })}
+          />
         </span>
         <span className="condition-card__trend">{t("dashboard.mix.reference")}</span>
       </footer>
     </DashboardCard>
   );
 }
diff --git a/src/components/dashboard/VolumeCard/VolumeCard.tsx b/src/components/dashboard/VolumeCard/VolumeCard.tsx
index 8e34fad..52cf80e 100644
--- a/src/components/dashboard/VolumeCard/VolumeCard.tsx
+++ b/src/components/dashboard/VolumeCard/VolumeCard.tsx
@@ -1,36 +1,45 @@
 import type { JSX } from "react";
 import { useTranslation } from "react-i18next";
 import type { WeeklyVolumeInsight } from "../../../domain/training-dashboard";
+import { CountUp } from "../../ui";
 import { DashboardCard } from "../DashboardCard/DashboardCard";
 import { decimal } from "../dashboardFormatters";
 import { Trend } from "../Trend/Trend";
 
 export function VolumeCard({
   insight,
   language,
   windowDays,
 }: Readonly<{ insight: WeeklyVolumeInsight; language: string; windowDays: number }>): JSX.Element {
   const { t } = useTranslation();
   return (
     <DashboardCard
       kind="volume"
       title={t("dashboard.volume.title")}
       badge={<span className="condition-card__period">{t("dashboard.perWeek")}</span>}
     >
       <p className="condition-card__metric">
-        {decimal(insight.averageWeeklyDistanceMeters / 1_000, language)}
+        <CountUp
+          value={insight.averageWeeklyDistanceMeters / 1_000}
+          format={(kilometers) => decimal(kilometers, language)}
+        />
         <small>km</small>
       </p>
       <p className="condition-card__context">
-        {t("dashboard.volume.total", {
-          distance: decimal(insight.distanceMeters / 1_000, language),
-          count: insight.workoutCount,
-        })}
+        <CountUp
+          value={insight.distanceMeters / 1_000}
+          format={(kilometers) =>
+            t("dashboard.volume.total", {
+              distance: decimal(kilometers, language),
+              count: insight.workoutCount,
+            })
+          }
+        />
       </p>
       <footer>
         <span>{t("dashboard.volume.window", { count: windowDays / 7 })}</span>
         <Trend trend={insight.trend} language={language} kind="volume" />
       </footer>
     </DashboardCard>
   );
 }
