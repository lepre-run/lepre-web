diff --git a/src/hooks/useCountUp.test.ts b/src/hooks/useCountUp.test.ts
new file mode 100644
index 0000000..3c77d63
--- /dev/null
+++ b/src/hooks/useCountUp.test.ts
@@ -0,0 +1,84 @@
+import { act, renderHook } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { preferReducedMotion, stubAnimationFrames } from "../test/motion";
+import { useCountUp } from "./useCountUp";
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+function renderCountUp(initial: number) {
+  return renderHook(({ value }) => useCountUp(value, { duration: 400 }), {
+    initialProps: { value: initial },
+  });
+}
+
+describe("useCountUp", () => {
+  it("shows the first value immediately without animating", () => {
+    const frames = stubAnimationFrames();
+    const { result } = renderCountUp(42);
+
+    expect(result.current).toBe(42);
+    expect(frames.pending()).toBe(0);
+  });
+
+  it("interpolates from the previous value and ends exactly on the new one", () => {
+    const frames = stubAnimationFrames();
+    const { result, rerender } = renderCountUp(10);
+
+    rerender({ value: 20 });
+    expect(result.current).toBe(10);
+    act(() => frames.runFrame(1_000));
+    expect(result.current).toBe(10);
+    act(() => frames.runFrame(1_200));
+    expect(result.current).toBeGreaterThan(10);
+    expect(result.current).toBeLessThan(20);
+    act(() => frames.runFrame(1_400));
+    expect(result.current).toBe(20);
+    expect(frames.pending()).toBe(0);
+  });
+
+  it("continues from the displayed value when the target changes mid-animation", () => {
+    const frames = stubAnimationFrames();
+    const { result, rerender } = renderCountUp(0);
+
+    rerender({ value: 100 });
+    act(() => frames.runFrame(0));
+    act(() => frames.runFrame(200));
+    const interrupted = result.current;
+    rerender({ value: 50 });
+    expect(result.current).toBe(interrupted);
+    act(() => frames.runFrame(300));
+    act(() => frames.runFrame(700));
+    expect(result.current).toBe(50);
+  });
+
+  it("jumps to the final value when reduced motion is preferred", () => {
+    preferReducedMotion();
+    const frames = stubAnimationFrames();
+    const { result, rerender } = renderCountUp(10);
+
+    rerender({ value: 20 });
+
+    expect(result.current).toBe(20);
+    expect(frames.pending()).toBe(0);
+  });
+
+  it("cancels the pending frame when unmounted mid-animation", () => {
+    const frames = stubAnimationFrames();
+    const errors = vi.spyOn(console, "error");
+    const { rerender, unmount } = renderCountUp(10);
+
+    rerender({ value: 20 });
+    act(() => frames.runFrame(0));
+    act(() => frames.runFrame(100));
+    expect(frames.pending()).toBe(1);
+    unmount();
+
+    expect(cancelAnimationFrame).toHaveBeenCalled();
+    expect(frames.pending()).toBe(0);
+    expect(() => frames.runFrame(400)).not.toThrow();
+    expect(errors).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/hooks/useCountUp.ts b/src/hooks/useCountUp.ts
new file mode 100644
index 0000000..3d6bff3
--- /dev/null
+++ b/src/hooks/useCountUp.ts
@@ -0,0 +1,46 @@
+import { useEffect, useRef, useState } from "react";
+import { countUpValue } from "./countUp";
+import { MOTION_DURATION_SLOW_MS } from "./motionDurations";
+import { usePrefersReducedMotion } from "./usePrefersReducedMotion";
+
+type CountUpOptions = Readonly<{ duration?: number }>;
+
+function animateCountUp(
+  from: number,
+  to: number,
+  duration: number,
+  onFrame: (value: number) => void,
+): () => void {
+  const animation = { frame: 0, start: -1 };
+  const step = (now: number): void => {
+    if (animation.start < 0) animation.start = now;
+    const value = countUpValue(from, to, now - animation.start, duration);
+    onFrame(value);
+    if (value !== to) animation.frame = requestAnimationFrame(step);
+  };
+  animation.frame = requestAnimationFrame(step);
+  return () => cancelAnimationFrame(animation.frame);
+}
+
+export function useCountUp(
+  value: number,
+  { duration = MOTION_DURATION_SLOW_MS }: CountUpOptions = {},
+): number {
+  const reducedMotion = usePrefersReducedMotion();
+  const [displayed, setDisplayed] = useState(value);
+  const displayedRef = useRef(value);
+
+  useEffect(() => {
+    const show = (next: number): void => {
+      displayedRef.current = next;
+      setDisplayed(next);
+    };
+    if (reducedMotion || displayedRef.current === value) {
+      show(value);
+      return;
+    }
+    return animateCountUp(displayedRef.current, value, duration, show);
+  }, [value, duration, reducedMotion]);
+
+  return reducedMotion ? value : displayed;
+}
diff --git a/src/hooks/usePrefersReducedMotion.test.ts b/src/hooks/usePrefersReducedMotion.test.ts
new file mode 100644
index 0000000..8d86210
--- /dev/null
+++ b/src/hooks/usePrefersReducedMotion.test.ts
@@ -0,0 +1,44 @@
+import { act, renderHook } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { preferReducedMotion, stubMediaQuery } from "../test/motion";
+import { usePrefersReducedMotion } from "./usePrefersReducedMotion";
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+describe("usePrefersReducedMotion", () => {
+  it("allows motion when the runner has no reduced-motion preference", () => {
+    stubMediaQuery(false);
+    const { result } = renderHook(() => usePrefersReducedMotion());
+    expect(result.current).toBe(false);
+  });
+
+  it("reports the reduced-motion preference and follows later changes", () => {
+    const query = preferReducedMotion();
+    const { result } = renderHook(() => usePrefersReducedMotion());
+    expect(window.matchMedia).toHaveBeenCalledWith("(prefers-reduced-motion: reduce)");
+    expect(result.current).toBe(true);
+
+    act(() => {
+      Object.assign(query, { matches: false });
+      query.dispatchEvent(new Event("change"));
+    });
+    expect(result.current).toBe(false);
+  });
+
+  it("falls back to allowing motion when matchMedia is unavailable", () => {
+    const original = window.matchMedia;
+    Object.defineProperty(window, "matchMedia", { configurable: true, value: undefined });
+    try {
+      const { result } = renderHook(() => usePrefersReducedMotion());
+      expect(result.current).toBe(false);
+    } finally {
+      Object.defineProperty(window, "matchMedia", {
+        configurable: true,
+        writable: true,
+        value: original,
+      });
+    }
+  });
+});
diff --git a/src/hooks/usePrefersReducedMotion.ts b/src/hooks/usePrefersReducedMotion.ts
new file mode 100644
index 0000000..030d5ee
--- /dev/null
+++ b/src/hooks/usePrefersReducedMotion.ts
@@ -0,0 +1,21 @@
+import { useSyncExternalStore } from "react";
+
+const REDUCED_MOTION_QUERY = "(prefers-reduced-motion: reduce)";
+
+function reducedMotionQuery(): MediaQueryList | null {
+  return typeof window.matchMedia === "function" ? window.matchMedia(REDUCED_MOTION_QUERY) : null;
+}
+
+function subscribe(onChange: () => void): () => void {
+  const query = reducedMotionQuery();
+  query?.addEventListener("change", onChange);
+  return () => query?.removeEventListener("change", onChange);
+}
+
+function prefersReducedMotion(): boolean {
+  return reducedMotionQuery()?.matches ?? false;
+}
+
+export function usePrefersReducedMotion(): boolean {
+  return useSyncExternalStore(subscribe, prefersReducedMotion, () => false);
+}
diff --git a/src/hooks/useWorkoutArrivals.test.ts b/src/hooks/useWorkoutArrivals.test.ts
new file mode 100644
index 0000000..c23c420
--- /dev/null
+++ b/src/hooks/useWorkoutArrivals.test.ts
@@ -0,0 +1,83 @@
+import { act, renderHook } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { Workout } from "../domain/workout";
+import { preferReducedMotion } from "../test/motion";
+import { buildWeeklyWorkout } from "../test/weekly-builders";
+import { useWorkoutArrivals } from "./useWorkoutArrivals";
+
+afterEach(() => {
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+});
+
+const first = buildWeeklyWorkout("workout:first", "2026-07-20T06:00:00Z");
+const second = buildWeeklyWorkout("workout:second", "2026-07-21T06:00:00Z");
+const third = buildWeeklyWorkout("workout:third", "2026-07-22T06:00:00Z");
+
+function renderArrivals(workouts: ReadonlyArray<Workout>, hydrated: boolean) {
+  return renderHook((props) => useWorkoutArrivals(props.workouts, props.hydrated), {
+    initialProps: { workouts, hydrated },
+  });
+}
+
+describe("useWorkoutArrivals", () => {
+  it("does not animate workouts from the initial IndexedDB load", () => {
+    const { result, rerender } = renderArrivals([], false);
+    rerender({ workouts: [first, second], hydrated: false });
+    rerender({ workouts: [first, second], hydrated: true });
+
+    expect(result.current.size).toBe(0);
+  });
+
+  it("marks workouts added by a later synchronization batch", () => {
+    const { result, rerender } = renderArrivals([first], true);
+
+    rerender({ workouts: [first, second, third], hydrated: true });
+
+    expect(Array.from(result.current)).toEqual([
+      ["workout:third", 0],
+      ["workout:second", 1],
+    ]);
+  });
+
+  it("animates the first batch for a runner whose local store was empty", () => {
+    const { result, rerender } = renderArrivals([], true);
+
+    rerender({ workouts: [first], hydrated: true });
+
+    expect(result.current.get("workout:first")).toBe(0);
+  });
+
+  it("keeps settled arrivals stable across re-renders without new workouts", () => {
+    const { result, rerender } = renderArrivals([first], true);
+    const synchronized = [first, second];
+    rerender({ workouts: synchronized, hydrated: true });
+    const arrivals = result.current;
+
+    rerender({ workouts: synchronized, hydrated: true });
+    rerender({ workouts: [...synchronized], hydrated: true });
+
+    expect(result.current).toBe(arrivals);
+  });
+
+  it("does not mark arrivals when reduced motion is preferred", () => {
+    preferReducedMotion();
+    const { result, rerender } = renderArrivals([first], true);
+
+    rerender({ workouts: [first, second], hydrated: true });
+
+    expect(result.current.size).toBe(0);
+  });
+
+  it("clears arrival marks once the entrance animation has finished", () => {
+    vi.useFakeTimers();
+    const { result, rerender } = renderArrivals([first], true);
+    rerender({ workouts: [first, second], hydrated: true });
+    expect(result.current.size).toBe(1);
+
+    act(() => vi.advanceTimersByTime(399));
+    expect(result.current.size).toBe(1);
+    act(() => vi.advanceTimersByTime(1));
+    expect(result.current.size).toBe(0);
+  });
+});
diff --git a/src/hooks/useWorkoutArrivals.ts b/src/hooks/useWorkoutArrivals.ts
new file mode 100644
index 0000000..1036d3b
--- /dev/null
+++ b/src/hooks/useWorkoutArrivals.ts
@@ -0,0 +1,64 @@
+import { useEffect, useState } from "react";
+import {
+  arrivalOrder,
+  NO_ARRIVALS,
+  newWorkoutIds,
+  type WorkoutArrivals,
+} from "../components/weekly-overview/workoutArrivals";
+import type { Workout } from "../domain/workout";
+import { MOTION_DURATION_SLOW_MS } from "./motionDurations";
+import { usePrefersReducedMotion } from "./usePrefersReducedMotion";
+
+type ArrivalTracking = Readonly<{
+  workouts: ReadonlyArray<Workout> | null;
+  hydrated: boolean;
+  knownIds: ReadonlySet<string> | null;
+  arrivals: WorkoutArrivals;
+}>;
+
+const UNTRACKED: ArrivalTracking = {
+  workouts: null,
+  hydrated: false,
+  knownIds: null,
+  arrivals: NO_ARRIVALS,
+};
+
+function trackArrivals(
+  previous: ArrivalTracking,
+  workouts: ReadonlyArray<Workout>,
+  hydrated: boolean,
+): ArrivalTracking {
+  if (!hydrated) return { ...UNTRACKED, workouts };
+  const arrived = newWorkoutIds(previous.knownIds, workouts);
+  return {
+    workouts,
+    hydrated,
+    knownIds: new Set(workouts.map((workout) => workout.id)),
+    arrivals: arrived.size === 0 ? previous.arrivals : arrivalOrder(arrived, workouts),
+  };
+}
+
+export function useWorkoutArrivals(
+  workouts: ReadonlyArray<Workout>,
+  hydrated: boolean,
+): WorkoutArrivals {
+  const reducedMotion = usePrefersReducedMotion();
+  const [tracking, setTracking] = useState(() => trackArrivals(UNTRACKED, workouts, hydrated));
+  const changed = tracking.workouts !== workouts || tracking.hydrated !== hydrated;
+  const current = changed ? trackArrivals(tracking, workouts, hydrated) : tracking;
+  if (changed) setTracking(current);
+  useEffect(() => {
+    if (current.arrivals.size === 0) return;
+    const settled = current.arrivals;
+    const timeout = window.setTimeout(
+      () => setTracking((latest) => settleArrivals(latest, settled)),
+      MOTION_DURATION_SLOW_MS,
+    );
+    return () => window.clearTimeout(timeout);
+  }, [current.arrivals]);
+  return reducedMotion ? NO_ARRIVALS : current.arrivals;
+}
+
+function settleArrivals(tracking: ArrivalTracking, settled: WorkoutArrivals): ArrivalTracking {
+  return tracking.arrivals === settled ? { ...tracking, arrivals: NO_ARRIVALS } : tracking;
+}
