@@ -1,38 +1,42 @@
 import type { JSX } from "react";
 import { WeeklyDay } from "../WeeklyDay/WeeklyDay";
 import { WeeklyDetail } from "../WeeklyDetail/WeeklyDetail";
 import { WeeklySummary } from "../WeeklySummary/WeeklySummary";
 import type { WorkoutWeek } from "../weeklyOverview";
+import { NO_ARRIVALS, type WorkoutArrivals } from "../workoutArrivals";
 
 export function WeekRow({
   week,
   language,
   selectedWorkoutId,
   onSelect,
   onClose,
   weekdayFormatter,
+  arrivals = NO_ARRIVALS,
 }: Readonly<{
   week: WorkoutWeek;
   language: string;
   selectedWorkoutId: string | null;
   onSelect: (workoutId: string) => void;
   onClose: () => void;
   weekdayFormatter: Intl.DateTimeFormat;
+  arrivals?: WorkoutArrivals;
 }>): JSX.Element {
   const selectedWorkout = week.workouts.find((workout) => workout.id === selectedWorkoutId) ?? null;
   return (
     <li className="weekly-grid__week" data-resting={week.workouts.length === 0} key={week.dateKey}>
       <WeeklySummary week={week} language={language} weekdayFormatter={weekdayFormatter} />
       {week.days.map((day) => (
         <WeeklyDay
           day={day}
           language={language}
           selectedWorkoutId={selectedWorkoutId}
           onSelect={onSelect}
+          arrivals={arrivals}
           key={day.dateKey}
         />
       ))}
       {selectedWorkout && <WeeklyDetail workout={selectedWorkout} onClose={onClose} />}
     </li>
   );
 }
diff --git a/src/components/weekly-overview/WeeklyDay/WeeklyDay.tsx b/src/components/weekly-overview/WeeklyDay/WeeklyDay.tsx
index 1ae99ad..7fe5bd5 100644
--- a/src/components/weekly-overview/WeeklyDay/WeeklyDay.tsx
+++ b/src/components/weekly-overview/WeeklyDay/WeeklyDay.tsx
@@ -1,53 +1,57 @@
 import type { JSX } from "react";
 import { useTranslation } from "react-i18next";
 import { localeFor } from "../../../i18n/i18n";
 import { WorkoutButton } from "../WorkoutButton/WorkoutButton";
 import type { WorkoutDay } from "../weeklyOverview";
+import { NO_ARRIVALS, type WorkoutArrivals } from "../workoutArrivals";
 
 export function WeeklyDay({
   day,
   language,
   selectedWorkoutId,
   onSelect,
+  arrivals = NO_ARRIVALS,
 }: Readonly<{
   day: WorkoutDay;
   language: string;
   selectedWorkoutId: string | null;
   onSelect: (workoutId: string) => void;
+  arrivals?: WorkoutArrivals;
 }>): JSX.Element {
   const { t } = useTranslation();
   const weekday = new Intl.DateTimeFormat(localeFor(language), { weekday: "short" });
   const mobileDate = new Intl.DateTimeFormat(localeFor(language), {
     day: "numeric",
     month: "short",
   });
   return (
     <div className="weekly-day" data-empty={day.workouts.length === 0}>
       <time className="visually-hidden" dateTime={day.dateKey}>
         {new Intl.DateTimeFormat(localeFor(language), { dateStyle: "full" }).format(day.date)}
       </time>
       {day.workouts.length > 0 && (
         <div className="weekly-day__heading" aria-hidden="true">
           <span>{weekday.format(day.date)}</span>
           <time>{mobileDate.format(day.date)}</time>
         </div>
       )}
       {day.workouts.length === 0 ? (
         <span className="weekly-day__empty">
           <span aria-hidden="true">—</span>
           <span className="visually-hidden">{t("weekly.restDay")}</span>
         </span>
       ) : (
         day.workouts.map((workout) => (
           <WorkoutButton
             workout={workout}
             selected={workout.id === selectedWorkoutId}
             language={language}
             onSelect={() => onSelect(workout.id)}
+            arrivalOrder={arrivals.get(workout.id)}
             key={workout.id}
           />
         ))
       )}
     </div>
   );
 }
diff --git a/src/components/weekly-overview/WeeklyOverview/WeeklyOverview.tsx b/src/components/weekly-overview/WeeklyOverview/WeeklyOverview.tsx
index 64ff825..f62b1f4 100644
--- a/src/components/weekly-overview/WeeklyOverview/WeeklyOverview.tsx
+++ b/src/components/weekly-overview/WeeklyOverview/WeeklyOverview.tsx
@@ -1,65 +1,68 @@
 import { type JSX, useMemo, useState } from "react";
 import { useTranslation } from "react-i18next";
 import type { Workout } from "../../../domain/workout";
 import { localeFor } from "../../../i18n/i18n";
 import { Pagination } from "../../ui";
 import { WeekRow } from "../WeekRow/WeekRow";
 import { pageCount, weeksOnPage, workoutWeeks } from "../weeklyOverview";
+import { NO_ARRIVALS, type WorkoutArrivals } from "../workoutArrivals";
 
 export function WeeklyOverview({
   workouts,
-}: Readonly<{ workouts: ReadonlyArray<Workout> }>): JSX.Element {
+  arrivals = NO_ARRIVALS,
+}: Readonly<{ workouts: ReadonlyArray<Workout>; arrivals?: WorkoutArrivals }>): JSX.Element {
   const { t, i18n } = useTranslation();
   const language = i18n.resolvedLanguage ?? i18n.language;
   const weeks = useMemo(() => workoutWeeks(workouts), [workouts]);
   const totalPages = pageCount(weeks);
   const [page, setPage] = useState(0);
   const [selectedWorkoutId, setSelectedWorkoutId] = useState<string | null>(null);
   const visibleWeeks = weeksOnPage(weeks, Math.min(page, totalPages - 1));
   const weekdays = new Intl.DateTimeFormat(localeFor(language), { weekday: "short" });
   const changePage = (next: number): void => {
     setPage(next);
     setSelectedWorkoutId(null);
   };
   const selectWorkout = (id: string): void =>
     setSelectedWorkoutId((current) => (current === id ? null : id));
 
   return (
     <section className="weekly-overview" aria-label={t("weekly.label")}>
       <div className="weekly-overview__scroll">
         <div className="weekly-grid">
           <div className="weekly-grid__header" aria-hidden="true">
             <span>{t("weekly.week")}</span>
             {visibleWeeks[0]?.days.map((day) => (
               <span key={day.dateKey}>{weekdays.format(day.date)}</span>
             ))}
           </div>
           <ol className="weekly-grid__weeks">
             {visibleWeeks.map((week) => (
               <WeekRow
                 week={week}
                 language={language}
                 selectedWorkoutId={selectedWorkoutId}
                 onSelect={selectWorkout}
                 onClose={() => setSelectedWorkoutId(null)}
                 weekdayFormatter={weekdays}
+                arrivals={arrivals}
                 key={week.dateKey}
               />
             ))}
           </ol>
         </div>
       </div>
       <Pagination
         className="weekly-pagination"
         ariaLabel={t("weekly.pagination")}
         previousLabel={`← ${t("weekly.newer")}`}
         nextLabel={`${t("weekly.older")} →`}
         pageLabel={t("weekly.page", { current: page + 1, total: totalPages })}
         previousDisabled={page === 0}
         nextDisabled={page >= totalPages - 1}
         onPrevious={() => changePage(page - 1)}
         onNext={() => changePage(page + 1)}
       />
     </section>
   );
 }
diff --git a/src/components/weekly-overview/WeeklyOverview/WeeklyOverviewArrivals.test.tsx b/src/components/weekly-overview/WeeklyOverview/WeeklyOverviewArrivals.test.tsx
new file mode 100644
index 0000000..f99d5e9
--- /dev/null
+++ b/src/components/weekly-overview/WeeklyOverview/WeeklyOverviewArrivals.test.tsx
@@ -0,0 +1,47 @@
+import { act, fireEvent, render, screen } from "@testing-library/react";
+import i18n from "i18next";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Workout } from "../../../domain/workout";
+import { useWorkoutArrivals } from "../../../hooks/useWorkoutArrivals";
+import { buildWeeklyWorkout } from "../../../test/weekly-builders";
+import { WeeklyOverview } from "./WeeklyOverview";
+
+beforeEach(async () => {
+  await i18n.changeLanguage("en");
+  vi.useFakeTimers();
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+function SynchronizedOverview({ workouts }: Readonly<{ workouts: ReadonlyArray<Workout> }>) {
+  return <WeeklyOverview workouts={workouts} arrivals={useWorkoutArrivals(workouts, true)} />;
+}
+
+const history = Array.from({ length: 6 }, (_, index) =>
+  buildWeeklyWorkout(
+    `workout:history-${index}`,
+    new Date(Date.UTC(2026, 6, 20 - index * 7, 6)).toISOString(),
+    `Week ${index + 1}`,
+  ),
+);
+
+describe("WeeklyOverview arrivals", () => {
+  it("does not replay the arrival animation after paging away and back", () => {
+    const arrived = buildWeeklyWorkout("workout:arrived", "2026-07-21T06:00:00Z", "Fresh run");
+    const { rerender } = render(<SynchronizedOverview workouts={history} />);
+    rerender(<SynchronizedOverview workouts={[arrived, ...history]} />);
+    expect(screen.getByRole("button", { name: /Open Fresh run/ })).toHaveAttribute(
+      "data-new",
+      "true",
+    );
+
+    act(() => vi.advanceTimersByTime(400));
+    fireEvent.click(screen.getByRole("button", { name: /Older weeks/ }));
+    fireEvent.click(screen.getByRole("button", { name: /Newer weeks/ }));
+
+    expect(screen.getByRole("button", { name: /Open Fresh run/ })).not.toHaveAttribute("data-new");
+    expect(screen.getByRole("button", { name: /Open Week 1/ })).not.toHaveAttribute("data-new");
+  });
+});
