{
  "name": "lepre-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run biome:check",
    "habits:check": "uvx --from 'habit-hooks[typescript]==1.5.0' --with 'habit-hooks-typescript==1.5.0' --with 'habit-hooks-generic==1.5.0' habit-hooks --all",
    "lint": "biome check src",
    "format": "biome format --write src",
    "test": "vitest",
    "test:habits": "uv run --no-project --python 3.11 python -B -m unittest discover -s .habit-hooks/biome/tests -p 'test_*.py'",
    "typecheck": "tsc --noEmit",
    "biome:check": "biome check .",
    "postinstall": "patch-package",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "i18next": "^26.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-doodle-icons": "^1.0.0",
    "react-i18next": "^17.1.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jscpd": "5.4.2",
    "knip": "6.42.1",
    "msw": "^2.15.0",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.2",
    "typescript-compiler": "npm:typescript@6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
